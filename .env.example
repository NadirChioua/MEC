# =====================================================================
# Morocco Europe Consulting — variables d'environnement
#
# Copiez ce fichier en .env.local pour le développement local.
# En production, saisissez ces valeurs dans Vercel :
#   Project Settings > Environment Variables
#
# .env.local et .env sont ignorés par git (voir .gitignore). Ne committez
# JAMAIS une valeur réelle dans ce fichier d'exemple.
# =====================================================================

# ---------------------------------------------------------------------
# FORMULAIRE DE CONTACT (déjà en place, ne pas modifier)
# ---------------------------------------------------------------------

# Clé API Resend, fournisseur d'envoi principal du formulaire de contact.
RESEND_API_KEY=

# Adresse qui reçoit les demandes du formulaire.
CONTACT_TO_EMAIL=contact@mecfinance.ma

# Expéditeur affiché. Le domaine doit être vérifié dans Resend.
CONTACT_FROM_EMAIL=Morocco Europe Consulting <noreply@send.mecfinance.ma>

# Point de terminaison Formspree, utilisé en secours si Resend est absent.
FORMSPREE_ENDPOINT=

# ---------------------------------------------------------------------
# SUPABASE — base de données du dashboard analytics
# ---------------------------------------------------------------------

# URL du projet Supabase, visible dans Settings > API. Publique (préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (sb_publishable_...). Exposée au navigateur par conception :
# c'est la RLS qui protège les données, pas le secret de cette clé.
# Les anciens projets utilisent NEXT_PUBLIC_SUPABASE_ANON_KEY, également accepté.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (sb_secret_...) : contourne la RLS. SECRÈTE — uniquement côté
# serveur, jamais préfixée NEXT_PUBLIC_, jamais partagée, jamais committée.
# Les anciens projets utilisent SUPABASE_SERVICE_ROLE_KEY, également accepté.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# ANALYTICS
# ---------------------------------------------------------------------

# Sel secret du hachage visiteur. Combiné à la date du jour, il rend
# l'identifiant anonyme et non traçable d'un jour à l'autre.
# Générer avec :  openssl rand -base64 32
# Changer cette valeur réinitialise le comptage des visiteurs uniques.
ANALYTICS_SALT=

# Jeton protégeant /api/cron/rollup. Vercel l'envoie automatiquement en
# en-tête Authorization: Bearer lors du cron quotidien.
# Générer avec :  openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------
# CRÉATION DU PREMIER ADMINISTRATEUR
# Utilisées uniquement par `npm run create-admin`, en local.
# À retirer de votre .env.local une fois le compte créé.
# ---------------------------------------------------------------------

# Email du compte administrateur du dashboard.
ADMIN_EMAIL=

# Mot de passe initial (12 caractères minimum). Ne pas réutiliser un mot
# de passe existant, et le changer après la première connexion.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# SEO — vérification des moteurs de recherche (facultatif)
# ---------------------------------------------------------------------

# Code "balise HTML" de Google Search Console (valeur de content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Code "msvalidate.01" de Bing Webmaster Tools.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
